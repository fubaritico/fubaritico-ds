{
  "name": "fubaritico-ds-tmdb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter @fubar-it-co/tmdb-client build && pnpm --filter @fubaritico-ds/tokens build && pnpm --filter @fubaritico-ds/shared build && pnpm --filter @fubaritico-ds/ui build && pnpm --filter @fubaritico-ds/layouts build",
    "dev:packages": "concurrently -n shared,ui,layouts \"pnpm --filter @fubaritico-ds/shared dev\" \"pnpm --filter @fubaritico-ds/ui dev\" \"pnpm --filter @fubaritico-ds/layouts dev\"",
    "dev:apps": "lerna run --stream --parallel dev --ignore @fubaritico-ds/storybook --ignore @fubaritico-ds/shared --ignore @fubaritico-ds/ui --ignore @fubaritico-ds/layouts --ignore @fubaritico-ds/tokens",
    "dev": "pnpm build:packages && concurrently -n packages,apps \"pnpm dev:packages\" \"wait-on packages/shared/dist/index.js packages/ui/dist/index.js packages/layouts/dist/index.js && pnpm dev:apps\"",
    "prod": "lerna run --stream prod",
    "prod:server": "lerna run --stream prod:server",
    "type-check": "tsc -p ./ --noEmit",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx .",
    "lint:fix": "eslint --ext .ts,.tsx,.js,.jsx . --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "a11y": "pa11y-ci",
    "a11y:report": "pa11y-ci --reporter csv > a11y-report.csv",
    "reset": "./scripts/reset-project.sh",
    "setup": "./scripts/setup.sh",
    "kill-ports": "./scripts/kill-ports.sh",
    "storybook": "pnpm --filter @fubaritico-ds/storybook storybook",
    "test:e2e": "pnpm --filter @fubaritico-ds/e2e test",
    "test:e2e:smoke": "pnpm --filter @fubaritico-ds/e2e test:smoke",
    "test:e2e:ui": "pnpm --filter @fubaritico-ds/e2e test:ui",
    "test:e2e:trace": "pnpm --filter @fubaritico-ds/e2e test:trace",
    "test:e2e:codegen": "pnpm --filter @fubaritico-ds/e2e test:codegen",
    "test:e2e:a11y": "pnpm --filter @fubaritico-ds/e2e test:a11y",
    "test:e2e:ui:a11y": "pnpm --filter @fubaritico-ds/e2e test:ui:a11y",
    "test:e2e:ci": "pnpm --filter @fubaritico-ds/e2e test:ci",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "dev:local": "./scripts/dev-local.sh",
    "postinstall": "chmod +x scripts/*.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lerna": "^8.2.2",
    "lint-staged": "^15.5.1",
    "pa11y-ci": "^4.1.0",
    "prettier": "3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.1.2",
    "cross-env": "^7.0.3",
    "wait-on": "^9.0.3",
    "wait-port": "^1.1.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.8.1"
}
