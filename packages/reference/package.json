{
  "name": "@fubaritico/react",
  "version": "0.1.0",
  "description": "React design-system components wearing the @fubaritico/styles native BEM skin. Tailwind-free: the skin is plain CSS driven by design tokens.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fubaritico/fubaritico-ds.git",
    "directory": "packages/reference"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:js": "tsup && tsc -p tsconfig.build.json",
    "build": "pnpm build:js && pnpm build:docs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "local-release:patch": "./publish-local.sh patch",
    "local-release:minor": "./publish-local.sh minor",
    "local-release:major": "./publish-local.sh major",
    "release:patch": "./publish.sh patch",
    "release:minor": "./publish.sh minor",
    "release:major": "./publish.sh major",
    "build:docs": "node script/copy-docs.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router-dom": ">=7"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fubaritico/shared": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "conventional-changelog": "catalog:",
    "jsdom": "catalog:",
    "next": "^16.2.0",
    "react-router-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@fubaritico/behaviors": "workspace:*",
    "@fubaritico/variants": "workspace:*",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "clsx": "catalog:",
    "html-entities": "catalog:"
  }
}
