{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.*",
    "vitest.setup.ts",
    "src/components/Carousel/**",
    "src/components/next/**",
    "src/**/*.bak",
    "src/components/WithTooltip/**"
  ]
}
