{
  "name": "@fubaritico/styles",
  "version": "0.2.0",
  "type": "module",
  "description": "Portable native BEM skin for the fubaritico design system — plain CSS in @layer, driven by @fubaritico/tokens and overridable through component-scoped --ui-* variables.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fubaritico/fubaritico-ds.git",
    "directory": "packages/styles"
  },
  "exports": {
    ".": "./dist/styles.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && mkdir -p dist && postcss src/native-styles.css -o dist/styles.css"
  },
  "peerDependencies": {
    "@fubaritico/tokens": "workspace:*"
  },
  "devDependencies": {
    "autoprefixer": "catalog:",
    "postcss": "catalog:",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "postcss-minify": "^1.2.0",
    "postcss-nested": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
