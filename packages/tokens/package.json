{
  "name": "@fubaritico/tokens",
  "version": "0.3.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ts/tokens.d.ts",
        "default": "./dist/js/tokens.js"
      }
    },
    "./css": "./dist/css/variables.css",
    "./tailwind": "./dist/tailwind/theme.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && style-dictionary build --config sd.config.js",
    "local-release:patch": "pnpm build && ./publish-local.sh patch",
    "local-release:minor": "pnpm build && ./publish-local.sh minor",
    "local-release:major": "pnpm build && ./publish-local.sh major",
    "release:patch": "pnpm build && ./publish.sh patch",
    "release:minor": "pnpm build && ./publish.sh minor",
    "release:major": "pnpm build && ./publish.sh major"
  },
  "devDependencies": {
    "conventional-changelog": "catalog:",
    "style-dictionary": "^4.3.0"
  },
  "description": "Design tokens for the fubaritico design system — DTCG sources (hex colours) compiled by Style Dictionary into CSS custom properties, JS/TS objects and a Tailwind theme.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fubaritico/fubaritico-ds.git",
    "directory": "packages/tokens"
  }
}
