{
  "color": {
    "semantic": {
      "$description": "Semantic tokens - use these in components",
      "background": {
        "default": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        },
        "subtle": {
          "$value": "{color.primitive.neutral.50}",
          "$type": "color"
        },
        "muted": { "$value": "{color.primitive.neutral.100}", "$type": "color" }
      },
      "foreground": {
        "default": {
          "$value": "{color.primitive.neutral.900}",
          "$type": "color"
        },
        "muted": {
          "$value": "{color.primitive.neutral.500}",
          "$type": "color"
        },
        "subtle": {
          "$value": "{color.primitive.neutral.400}",
          "$type": "color"
        }
      },
      "primary": {
        "default": {
          "$value": "{color.primitive.neutral.900}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.primitive.neutral.800}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        }
      },
      "secondary": {
        "default": {
          "$value": "{color.primitive.neutral.100}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.primitive.neutral.200}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.900}",
          "$type": "color"
        }
      },
      "header": {
        "$description": "Application shell header bar (neutral-on-dark surface) — not the data-table column header (see table-header).",
        "background": {
          "$value": "{color.primitive.neutral.950}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        }
      },
      "table-header": {
        "$description": "Data-table column-header surface. Foreground is neutral.600 (not the lighter neutral.500) so the header text clears WCAG AA (~7.2:1) on the neutral.100 header background.",
        "background": {
          "$value": "{color.primitive.neutral.100}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.600}",
          "$type": "color"
        }
      },
      "footer": {
        "background": {
          "$value": "{color.primitive.neutral.800}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.200}",
          "$type": "color"
        }
      },
      "card": {
        "background": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.primitive.neutral.900}",
          "$type": "color"
        }
      },
      "border": {
        "default": {
          "$value": "{color.primitive.neutral.200}",
          "$type": "color"
        },
        "muted": { "$value": "{color.primitive.neutral.100}", "$type": "color" }
      },
      "input": {
        "background": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        },
        "border": {
          "$value": "{color.primitive.neutral.300}",
          "$type": "color"
        },
        "placeholder": {
          "$value": "{color.primitive.neutral.400}",
          "$type": "color"
        }
      },
      "ring": {
        "default": {
          "$value": "{color.primitive.neutral.500}",
          "$type": "color"
        }
      },
      "badge": {
        "default": {
          "background": {
            "$value": "{color.primitive.neutral.100}",
            "$type": "color"
          },
          "foreground": {
            "$value": "{color.primitive.neutral.700}",
            "$type": "color"
          }
        },
        "dark": {
          "background": {
            "$value": "{color.primitive.neutral.800}",
            "$type": "color"
          },
          "foreground": {
            "$value": "{color.primitive.neutral.100}",
            "$type": "color"
          }
        },
        "primary": {
          "background": {
            "$value": "{color.primitive.amber.600}",
            "$type": "color"
          },
          "foreground": {
            "$value": "{color.primitive.neutral.900}",
            "$type": "color"
          }
        }
      },
      "rating": {
        "filled": {
          "$value": "{color.primitive.neutral.900}",
          "$type": "color"
        },
        "empty": { "$value": "{color.primitive.neutral.300}", "$type": "color" }
      },
      "skeleton": {
        "base": { "$value": "{color.primitive.neutral.200}", "$type": "color" },
        "highlight": {
          "$value": "{color.primitive.neutral.100}",
          "$type": "color"
        }
      },
      "destructive": {
        "default": { "$value": "{color.primitive.red.500}", "$type": "color" },
        "hover": { "$value": "{color.primitive.red.600}", "$type": "color" },
        "foreground": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        }
      },
      "success": {
        "default": {
          "$value": "{color.primitive.green.500}",
          "$type": "color"
        },
        "hover": { "$value": "{color.primitive.green.600}", "$type": "color" },
        "foreground": {
          "$value": "{color.primitive.neutral.0}",
          "$type": "color"
        }
      }
    }
  }
}
